[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/toolbar.gd" id="1_toolbar"]

[node name="Toolbar" type="HBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_toolbar")

[node name="TypeLabel" type="Label" parent="."]
layout_mode = 2
text = "Machine type:"

[node name="TypeOption" type="OptionButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Moore: outputs depend only on the state.
Mealy: outputs depend on the state and the input."
selected = 0
item_count = 2
popup/item_0/text = "Moore"
popup/item_0/id = 0
popup/item_1/text = "Mealy"
popup/item_1/id = 1

[node name="Sep1" type="VSeparator" parent="."]
layout_mode = 2

[node name="AddStateButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Add State"

[node name="Sep2" type="VSeparator" parent="."]
layout_mode = 2

[node name="NewButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Start a new, empty machine"
text = "New"

[node name="SaveButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Save this machine to a .tres file"
text = "Save…"

[node name="LoadButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Open a machine saved earlier"
text = "Load…"
